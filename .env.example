# ClipSync-Server 部署环境变量模板
# 用法：cp .env.example .env，把下面每个密码都改成自己的强随机值。
# 生成随机密码：openssl rand -base64 24
#
# .env 已被 .gitignore 忽略，不会误提交。
#
# ⚠️ 职责划分：
#   .env        → 只管 docker compose 起容器（建库账号、宿主机端口映射）
#   config.yaml → 管 server 自己的一切，包括它**连**数据库用的账号密码
# 两边的 MySQL 账号密码要填成一样的，否则 server 连不上库。

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=clipsync
MYSQL_USER=clipsync
MYSQL_PASSWORD=change-me-app
# 映射到宿主机的端口。本机已有别的 MySQL 占用 3306 时改这里，
# 比如 13306，然后 server 端连 127.0.0.1:13306。
MYSQL_HOST_PORT=3306

# ===== Redis =====
# 留空表示不设密码（仅 compose 内部网络可达）；对外暴露时务必设置
REDIS_PASSWORD=
# 同上，本机已有 Redis 占用 6379 时改成 16379 之类
REDIS_HOST_PORT=6379

# ===== 认证 =====
# token 有效期（小时），720 = 30 天
TOKEN_TTL_HOURS=720
# 账号由管理员创建，客户端无注册入口；确需开放注册时改 true
ALLOW_REGISTER=false
# 首次启动自动创建的账号（已存在则跳过）；登录后请尽快改密码
BOOTSTRAP_USER=admin
BOOTSTRAP_PASSWORD=change-me-admin

# ===== 端到端加密 =====
# 三端都升级完成后改成 true：服务端将拒绝转发任何明文消息，
# 同时关闭 /push 明文调试接口。
E2EE_REQUIRE=false
